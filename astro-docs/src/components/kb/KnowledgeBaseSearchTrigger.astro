---
import { Icon } from '@astrojs/starlight/components';
---

<button class="kb-search-trigger" type="button" data-kb-search-trigger>
  <Icon name="magnifier" />
  <span>Search the Knowledge Base</span>
  <kbd><span class="kb-search-modifier">Ctrl</span> K</kbd>
</button>

<script>
  const trigger = document.querySelector<HTMLButtonElement>(
    '[data-kb-search-trigger]'
  );
  const globalSearchButton = document.querySelector<HTMLButtonElement>(
    'site-search button[data-open-modal]'
  );

  trigger?.addEventListener('click', (event) => {
    event.stopPropagation();
    globalSearchButton?.click();
  });

  const modifier = trigger?.querySelector<HTMLElement>('.kb-search-modifier');
  if (modifier && /(Mac|iPhone|iPod|iPad)/i.test(navigator.platform)) {
    modifier.textContent = '⌘';
  }
</script>

<style>
  .kb-search-trigger {
    display: flex;
    width: min(100%, 42rem);
    min-height: 3.25rem;
    margin: 0 auto;
    padding: 0.75rem 0.9rem;
    align-items: center;
    gap: 0.65rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.7rem;
    background: color-mix(in srgb, var(--sl-color-gray-6) 55%, transparent);
    color: var(--sl-color-gray-3);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      border-color 0.15s,
      color 0.15s,
      background 0.15s;
  }

  .kb-search-trigger:hover {
    border-color: var(--sl-color-gray-4);
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }

  .kb-search-trigger:focus-visible {
    outline: 2px solid var(--sl-color-accent-high);
    outline-offset: 3px;
  }

  .kb-search-trigger :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }

  .kb-search-trigger kbd {
    margin-left: auto;
    padding: 0.2rem 0.45rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.35rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-gray-3);
    font-family: var(--__sl-font);
    font-size: 0.72rem;
    white-space: nowrap;
  }
</style>
